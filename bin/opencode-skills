#!/data/data/com.termux/files/usr/bin/bash
# ==============================================================================
# OpenCode v2.0.19 - Skills & Model Configuration Manager
# Built for native Android / Termux with OpenCode terminal aesthetics
# ==============================================================================

set -e

# Setup TTY
if [ -t 0 ]; then
    HAS_TTY=true
elif [ -e /dev/tty ]; then
    exec < /dev/tty
    HAS_TTY=true
else
    HAS_TTY=false
fi

# ANSI Palette (Clean Zinc / OpenCode Colors)
ESC="\033"
C_RESET="${ESC}[0m"
C_BOLD="${ESC}[1m"
C_DIM="${ESC}[38;5;242m"
C_CYAN="${ESC}[38;5;81m"
C_GREEN="${ESC}[38;5;120m"
C_YELLOW="${ESC}[38;5;221m"
C_WHITE="${ESC}[38;5;255m"
C_GRAY="${ESC}[38;5;246m"
C_RED="${ESC}[38;5;203m"

hide_cursor() { printf "${ESC}[?25l"; }
show_cursor() { printf "${ESC}[?25h"; }

# Complete screen & scrollback buffer wipe
wipe_screen() {
    clear 2>/dev/null || true
    printf "${ESC}[H${ESC}[2J${ESC}[3J"
}

cleanup() {
    show_cursor
    printf "${C_RESET}\n"
}
trap cleanup EXIT INT TERM

CMD_DIR="$HOME/.config/opencode/commands"
REF_DIR="$HOME/.config/opencode/references"
CFG_DIR="$HOME/.config/opencode"
mkdir -p "$CMD_DIR" "$REF_DIR" "$CFG_DIR"

SKILL_KEYS=(
    "sec-audit"
    "logic-trainer"
    "complex-logic"
    "ui-ux"
    "backend-api"
    "perf-optimizer"
    "code-refactor"
    "code-reconstruct"
    "git-workflow"
    "db-optimizer"
)

SKILL_NAMES=(
    "sec-audit       "
    "logic-trainer   "
    "complex-logic   "
    "ui-ux           "
    "backend-api     "
    "perf-optimizer  "
    "code-refactor   "
    "code-reconstruct"
    "git-workflow    "
    "db-optimizer    "
)

# Compact labels for narrow mobile Termux screens (< 60 cols)
SKILL_SHORT_DESCS=(
    "Audit & Celah Keamanan"
    "Latihan Logika & Fallacy"
    "C.A.R.V.E. Reasoning"
    "Modern UI/UX Design"
    "REST API & Queues"
    "Performa & Memori"
    "Clean Code & Refactor"
    "Deobfuscate & AST"
    "Auto Git & Changelog"
    "SQL & Index Tuning"
)

# Full descriptions for wide terminals
SKILL_FULL_DESCS=(
    "Code Security Audit, Surface Mapping & Vulnerability Check"
    "Interactive Socratic Logic Sparring Coach & Fallacy Dissector"
    "C.A.R.V.E. Extreme Reasoning & Algorithmic Problem Solving"
    "Modern Interface Architecture, Design Systems & Anti-Slop UI"
    "Production Backend APIs, Idempotency, Queues & Auth Schemes"
    "Concurrency Benchmarking, Latency & Low-Memory Optimization"
    "Clean Architecture, Type Safety & Technical Debt Elimination"
    "Code Reconstruction, AST Normalization & Deobfuscation"
    "Conventional Commits Authoring & Release Changelog Automation"
    "SQL Query Tuning, Execution Plans & Schema Architecture"
)

TOTAL_SKILLS=${#SKILL_KEYS[@]}
CURRENT=0
SELECTED=()

for i in $(seq 0 $((TOTAL_SKILLS - 1))); do
    key="${SKILL_KEYS[$i]}"
    if [ -f "$CMD_DIR/$key.md" ]; then
        SELECTED+=("1")
    else
        SELECTED+=("0")
    fi
done

all_zero=true
for s in "${SELECTED[@]}"; do
    if [ "$s" -eq 1 ]; then
        all_zero=false
        break
    fi
done
if [ "$all_zero" = true ]; then
    for i in $(seq 0 $((TOTAL_SKILLS - 1))); do
        SELECTED[$i]=1
    done
fi

render_menu() {
    wipe_screen
    COLS=$(tput cols 2>/dev/null || echo 45)

    echo ""
    echo -e "  ${C_CYAN}${C_BOLD}OpenCode${C_RESET} ${C_DIM}v2.0.19 · Termux Edition${C_RESET}"
    echo ""
    echo -e "  ${C_WHITE}Pilih skill internal yang ingin diaktifkan:${C_RESET}"
    echo ""

    for i in $(seq 0 $((TOTAL_SKILLS - 1))); do
        if [ "${SELECTED[$i]}" -eq 1 ]; then
            CHECK="${C_GREEN}●${C_RESET}"
        else
            CHECK="${C_DIM}○${C_RESET}"
        fi

        if [ "$i" -eq 9 ]; then
            NUM="0"
        else
            NUM="$((i + 1))"
        fi

        NAME="${SKILL_NAMES[$i]}"

        if [ "$COLS" -lt 65 ]; then
            DESC="${SKILL_SHORT_DESCS[$i]}"
        else
            DESC="${SKILL_FULL_DESCS[$i]}"
        fi

        if [ "$i" -eq "$CURRENT" ]; then
            CURSOR="${C_CYAN}›${C_RESET}"
            LINE="${C_WHITE}${C_BOLD}$NUM. $NAME${C_RESET}  ${C_GRAY}$DESC${C_RESET}"
        else
            CURSOR=" "
            LINE="${C_DIM}$NUM. $NAME  $DESC${C_RESET}"
        fi

        echo -e "  $CURSOR $CHECK  $LINE"
    done

    echo ""
    DIVIDER_LEN=$((COLS - 4))
    [ "$DIVIDER_LEN" -gt 50 ] && DIVIDER_LEN=50
    [ "$DIVIDER_LEN" -lt 30 ] && DIVIDER_LEN=35
    DIVIDER=$(printf '─%.0s' $(seq 1 $DIVIDER_LEN))
    echo -e "  ${C_DIM}$DIVIDER${C_RESET}"
    echo -e "  ${C_DIM}Kontrol:${C_RESET} ${C_WHITE}[↑/↓]${C_RESET} Geser · ${C_WHITE}[Space/1-0]${C_RESET} Toggle · ${C_CYAN}[m]${C_RESET} Model"
    echo -e "  ${C_DIM}Aksi:   ${C_RESET} ${C_GREEN}[Enter]${C_RESET} Simpan · ${C_WHITE}[a]${C_RESET} Semua · ${C_DIM}[n] Reset · [q] Batal${C_RESET}"
}

configure_model() {
    show_cursor
    wipe_screen
    echo ""
    echo -e "  ${C_CYAN}${C_BOLD}OpenCode${C_RESET} ${C_DIM}v2.0.19 · Model & Provider Setup${C_RESET}"
    echo ""
    echo -e "  ${C_WHITE}Pilih provider LLM default:${C_RESET}"
    echo ""
    echo -e "   ${C_CYAN}1.${C_RESET} ${C_WHITE}Anthropic Claude${C_RESET}  ${C_DIM}(claude-3-7-sonnet)${C_RESET}"
    echo -e "   ${C_CYAN}2.${C_RESET} ${C_WHITE}OpenAI${C_RESET}            ${C_DIM}(gpt-4o / gpt-5)${C_RESET}"
    echo -e "   ${C_CYAN}3.${C_RESET} ${C_WHITE}Google Gemini${C_RESET}     ${C_DIM}(gemini-2.5-pro / flash)${C_RESET}"
    echo -e "   ${C_CYAN}4.${C_RESET} ${C_WHITE}OpenRouter${C_RESET}        ${C_DIM}(multi-provider proxy)${C_RESET}"
    echo -e "   ${C_CYAN}5.${C_RESET} ${C_WHITE}9router / Custom${C_RESET}  ${C_DIM}(custom baseURL & model)${C_RESET}"
    echo -e "   ${C_DIM}0. Kembali ke Menu Skill${C_RESET}"
    echo ""
    printf "  Pilihan [0-5]: "
    read -r m_choice

    case "$m_choice" in
        1)
            printf "\n  Anthropic API Key: "
            read -r api_key
            if [ -n "$api_key" ]; then
                cat << EOF > "$CFG_DIR/opencode.json"
{
  "\$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-3-7-sonnet",
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "$api_key"
      }
    }
  }
}
EOF
                export ANTHROPIC_API_KEY="$api_key"
                echo "export ANTHROPIC_API_KEY=\"$api_key\"" >> "$HOME/.bashrc" 2>/dev/null || true
                echo -e "\n  ${C_GREEN}✓ Disimpan: Claude 3.7 Sonnet${C_RESET}"
                sleep 1
            fi
            ;;
        2)
            printf "\n  OpenAI API Key: "
            read -r api_key
            if [ -n "$api_key" ]; then
                cat << EOF > "$CFG_DIR/opencode.json"
{
  "\$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-4o",
  "provider": {
    "openai": {
      "options": {
        "apiKey": "$api_key"
      }
    }
  }
}
EOF
                export OPENAI_API_KEY="$api_key"
                echo "export OPENAI_API_KEY=\"$api_key\"" >> "$HOME/.bashrc" 2>/dev/null || true
                echo -e "\n  ${C_GREEN}✓ Disimpan: OpenAI GPT-4o${C_RESET}"
                sleep 1
            fi
            ;;
        3)
            printf "\n  Gemini API Key: "
            read -r api_key
            if [ -n "$api_key" ]; then
                cat << EOF > "$CFG_DIR/opencode.json"
{
  "\$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-2.5-pro",
  "provider": {
    "google": {
      "options": {
        "apiKey": "$api_key"
      }
    }
  }
}
EOF
                export GEMINI_API_KEY="$api_key"
                echo "export GEMINI_API_KEY=\"$api_key\"" >> "$HOME/.bashrc" 2>/dev/null || true
                echo -e "\n  ${C_GREEN}✓ Disimpan: Google Gemini 2.5 Pro${C_RESET}"
                sleep 1
            fi
            ;;
        4)
            printf "\n  OpenRouter API Key: "
            read -r api_key
            if [ -n "$api_key" ]; then
                cat << EOF > "$CFG_DIR/opencode.json"
{
  "\$schema": "https://opencode.ai/config.json",
  "model": "openrouter/anthropic/claude-3.7-sonnet",
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "$api_key"
      }
    }
  }
}
EOF
                export OPENROUTER_API_KEY="$api_key"
                echo "export OPENROUTER_API_KEY=\"$api_key\"" >> "$HOME/.bashrc" 2>/dev/null || true
                echo -e "\n  ${C_GREEN}✓ Disimpan: OpenRouter${C_RESET}"
                sleep 1
            fi
            ;;
        5)
            printf "\n  Base URL (misal: https://9router.com/v1): "
            read -r base_url
            printf "  Model ID (misal: claude-3-7-sonnet): "
            read -r custom_model
            printf "  API Key: "
            read -r api_key
            if [ -n "$base_url" ] && [ -n "$custom_model" ]; then
                cat << EOF > "$CFG_DIR/opencode.json"
{
  "\$schema": "https://opencode.ai/config.json",
  "model": "openai/$custom_model",
  "provider": {
    "openai": {
      "options": {
        "baseURL": "$base_url",
        "apiKey": "$api_key"
      }
    }
  }
}
EOF
                echo -e "\n  ${C_GREEN}✓ Disimpan: Custom Provider ($custom_model)${C_RESET}"
                sleep 1
            fi
            ;;
        0|*)
            ;;
    esac
}

write_skill_file() {
    local key="$1"
    case "$key" in
        "sec-audit")
            cat << "SKILL_EOF"
---
description: Automated Code Security Evaluation, Attack Surface Mapping & Vulnerability Audit
---

You are an elite application security auditor and penetration testing specialist. When this command is executed, perform an exhaustive security evaluation of the current project:
1. Rujuk checklist audit di `~/.config/opencode/references/sec-audit/checklist-owasp.md` & `sast-patterns.md`.
2. Map attack surface: Ingress routes, HTTP parameters, CLI arguments, and WebSocket handlers.
3. Audit vulnerabilities: IDOR/BOLA, SQLi/Command Injection, SSRF, Hardcoded secrets, Race conditions in state mutations.
4. Provide concrete proof of concept test vectors and exact production-ready remediation patches.
SKILL_EOF
            ;;

        "logic-trainer")
            cat << "SKILL_EOF"
---
description: Interactive Socratic Logic Trainer, Cognitive Reasoning Spar & Fallacy Dissector
---

You are an exacting, elite Logic Sparring Coach and Cognitive Trainer. When invoked, start an interactive logic training session:
1. Rujuk taksonomi sesat pikir di `~/.config/opencode/references/logic-trainer/fallacies-taxonomy.md`.
2. Present one logic puzzle or argument at a time:
   - Round A: Premise-Claim-Hidden Assumption Dissection.
   - Round B: Formal If-Then & Affirming the Consequent Traps.
   - Round C: Quantifier Negation (All vs Exists).
   - Round D: Knights & Knaves Invariant Deduction.
3. Score strictly (1-10) with zero corporate fluff and pinpoint the mechanical reasoning flaw.
SKILL_EOF
            ;;

        "complex-logic")
            cat << "SKILL_EOF"
---
description: Deep Algorithmic Reasoning, Formal Logic & Multi-variable Problem Solving
---

You are an advanced cognitive reasoning engine. Solve complex problems using the **C.A.R.V.E. Framework**:
1. Rujuk spesifikasi protokol di `~/.config/opencode/references/complex-logic/carve-protocol.md`.
2. **C (Compress)**: Reduce problem to formal propositions, state graph, or boolean matrix.
3. **A (Anchor)**: Isolate invariants and boundary conditions that never change.
4. **R (Reverse)**: Backwards induction from goal state to initial state.
5. **V (Visualize)**: Map dependency DAGs and verify mutual exclusion / race-immunity.
6. **E (Execute)**: Produce verified code or mathematical proof with edge-case matrix.
SKILL_EOF
            ;;

        "ui-ux")
            cat << "SKILL_EOF"
---
description: High-tier UI/UX Engineering, Design Systems & Modern Interface Architecture
---

You are a principal frontend engineer and UI/UX architect specializing in modern, distinctive interfaces:
1. Rujuk standar token di `~/.config/opencode/references/ui-ux/design-tokens-guidelines.md`.
2. Reject generic AI purple slop. Enforce dark slate/zinc aesthetics (#09090b canvas, subtle 1px zinc-800 borders).
3. Apply strict 4px/8px spacing grid, WCAG AAA text contrast, and tactile micro-interactions (active:scale-[0.98]).
4. Ensure 100% fluid mobile responsiveness and zero layout shift (CLS).
SKILL_EOF
            ;;

        "backend-api")
            cat << "SKILL_EOF"
---
description: Production-grade Backend Engineering, API Contracts, Idempotency & Queues
---

You are a principal backend systems architect:
1. Rujuk panduan arsitektur di `~/.config/opencode/references/backend-api/idempotency-and-queues.md`.
2. Enforce strict API contracts, standard error envelopes, and schema-based validation (Zod/Pydantic).
3. Implement Idempotency-Key handling for financial/state-changing requests.
4. Design task queue pipelines with exponential backoff + jitter and Dead-Letter Queues (DLQ).
SKILL_EOF
            ;;

        "perf-optimizer")
            cat << "SKILL_EOF"
---
description: High-Concurrency Profiling, Latency Reduction & Memory Optimization
---

You are a systems performance engineer:
1. Rujuk panduan latensi & zero-copy di `~/.config/opencode/references/perf-optimizer/concurrency-and-memory.md`.
2. Eliminate event loop blocking, catastrophic regex, and quadratic O(N^2) bottlenecks.
3. Optimize memory: prevent closure leaks, enforce bounded LRU caches, and stream large payloads.
4. Eliminate lock contention using atomics or lock-free worker queues.
SKILL_EOF
            ;;

        "code-refactor")
            cat << "SKILL_EOF"
---
description: Clean Architecture, Idiomatic Refactoring & Technical Debt Elimination
---

You are a senior software architect:
1. Detect and eliminate code smells (God functions, deep nesting, implicit mutations).
2. Enforce Single Responsibility (SRP) and decouple pure business logic from I/O boundaries.
3. Deliver surgical, type-safe refactoring diffs with zero behavioral regression.
SKILL_EOF
            ;;

        "code-reconstruct")
            cat << "SKILL_EOF"
---
description: Code Reconstruction, AST Normalization & Deobfuscation Analysis
---

You are a static code reconstruction and reverse engineering specialist:
1. Rujuk panduan AST deobfuscation di `~/.config/opencode/references/code-reconstruct/ast-deobfuscation.md`.
2. De-minify variable names into semantic domain handles and unfold control flow flattening.
3. Extract hidden string arrays and reconstruct interface contracts.
SKILL_EOF
            ;;

        "git-workflow")
            cat << "SKILL_EOF"
---
description: Automated Git Operations, Conventional Commits & Release Changelog Generation
---

You are a release engineering and Git automation expert:
1. Inspect git diffs and organize changes into atomic commits following Conventional Commits format.
2. Generate clean, high-signal release changelog markdown documents.
SKILL_EOF
            ;;

        "db-optimizer")
            cat << "SKILL_EOF"
---
description: Database Query Optimization, Index Tuning & Schema Architecture
---

You are a database performance tuning specialist:
1. Rujuk aturan indeks komposit di `~/.config/opencode/references/db-optimizer/indexing-and-explain.md`.
2. Analyze query execution plans (EXPLAIN ANALYZE) and eliminate table scans and N+1 query patterns.
3. Formulate optimal composite indexes (equality -> range -> sort).
SKILL_EOF
            ;;
    esac
}

if [ "$HAS_TTY" = true ]; then
    hide_cursor
    while true; do
        render_menu
        IFS= read -rsn1 key

        if [[ "$key" == "$ESC" ]]; then
            read -rsn2 -t 0.1 rest || true
            case "$rest" in
                "[A") CURRENT=$(( (CURRENT - 1 + TOTAL_SKILLS) % TOTAL_SKILLS )) ;;
                "[B") CURRENT=$(( (CURRENT + 1) % TOTAL_SKILLS )) ;;
            esac
            continue
        fi

        case "$key" in
            "k"|"K") CURRENT=$(( (CURRENT - 1 + TOTAL_SKILLS) % TOTAL_SKILLS )) ;;
            "j"|"J") CURRENT=$(( (CURRENT + 1) % TOTAL_SKILLS )) ;;
            " ")
                SELECTED[$CURRENT]=$(( 1 - SELECTED[$CURRENT] ))
                ;;
            "1"|"2"|"3"|"4"|"5"|"6"|"7"|"8"|"9")
                idx=$((key - 1))
                SELECTED[$idx]=$(( 1 - SELECTED[$idx] ))
                CURRENT=$idx
                ;;
            "0")
                SELECTED[9]=$(( 1 - SELECTED[9] ))
                CURRENT=9
                ;;
            "a"|"A")
                for idx in $(seq 0 $((TOTAL_SKILLS - 1))); do
                    SELECTED[$idx]=1
                done
                ;;
            "n"|"N")
                for idx in $(seq 0 $((TOTAL_SKILLS - 1))); do
                    SELECTED[$idx]=0
                done
                ;;
            "m"|"M")
                configure_model
                hide_cursor
                ;;
            ""|$'\n'|$'\r')
                break
                ;;
            "q"|"Q")
                wipe_screen
                echo -e "\n  ${C_YELLOW}Batal, tidak ada perubahan disimpan.${C_RESET}\n"
                exit 0
                ;;
        esac
    done
    show_cursor
fi

wipe_screen
echo ""
echo -e "  ${C_CYAN}${C_BOLD}OpenCode${C_RESET} ${C_DIM}· Sinkronisasi skill...${C_RESET}"
echo ""

INSTALLED_COUNT=0
REMOVED_COUNT=0

for i in $(seq 0 $((TOTAL_SKILLS - 1))); do
    key="${SKILL_KEYS[$i]}"
    target="$CMD_DIR/$key.md"

    if [ "${SELECTED[$i]}" -eq 1 ]; then
        write_skill_file "$key" > "$target"
        echo -e "   ${C_GREEN}●${C_RESET} Aktif:  ${C_WHITE}user:$key${C_RESET}"
        INSTALLED_COUNT=$((INSTALLED_COUNT + 1))
    else
        if [ -f "$target" ]; then
            rm -f "$target"
            echo -e "   ${C_DIM}○ Dicopot: user:$key${C_RESET}"
            REMOVED_COUNT=$((REMOVED_COUNT + 1))
        fi
    fi
done

# Ensure AGENTS.md is present & injected into opencode.json
if [ ! -f "$CFG_DIR/AGENTS.md" ]; then
    cat << 'EOF' > "$CFG_DIR/AGENTS.md"
# Workspace Identity & Operating Soul

You are an expert AI software engineer, systems architect, and personal assistant.
Your operating principles:

## 1. Tone & Persona
- Direct, concise, technical, and outcome-oriented.
- Zero fluff, no unsolicited preambles, and no conversational filler ("Certainly!", "I hope this helps!").
- Lead with the solution, followed by necessary mechanics and architecture.

## 2. Engineering Standards
- Write clean, modular, and type-safe code.
- Prioritize high performance, zero-copy memory patterns, and minimal latency.
- Handle edge cases, runtime exceptions, and input validation proactively.
- Never substitute stubs, placeholders, or pseudocode for working implementations.
EOF
fi
ln -sf "$CFG_DIR/AGENTS.md" "$CFG_DIR/agent.md" 2>/dev/null || true

python3 - << 'PY' 2>/dev/null || node - << 'JS' 2>/dev/null || true
import json, os
path = os.path.expanduser("~/.config/opencode/opencode.json")
cfg = {}
if os.path.exists(path):
    try:
        with open(path, "r") as f:
            cfg = json.load(f)
    except: pass
cfg["$schema"] = cfg.get("$schema", "https://opencode.ai/config.json")
instructions = cfg.get("instructions", [])
rule = "{file:~/.config/opencode/AGENTS.md}"
if rule not in instructions:
    instructions.insert(0, rule)
cfg["instructions"] = instructions
agent = cfg.get("agent", {})
build = agent.get("build", {})
build["prompt"] = rule
agent["build"] = build
cfg["agent"] = agent
with open(path, "w") as f:
    json.dump(cfg, f, indent=2)
PY
const fs = require("fs");
const path = process.env.HOME + "/.config/opencode/opencode.json";
let cfg = {};
try { cfg = JSON.parse(fs.readFileSync(path, "utf8")); } catch(e){}
cfg.$schema = cfg.$schema || "https://opencode.ai/config.json";
cfg.instructions = cfg.instructions || [];
const rule = "{file:~/.config/opencode/AGENTS.md}";
if (!cfg.instructions.includes(rule)) { cfg.instructions.unshift(rule); }
cfg.agent = cfg.agent || {};
cfg.agent.build = cfg.agent.build || {};
cfg.agent.build.prompt = rule;
fs.writeFileSync(path, JSON.stringify(cfg, null, 2));
JS

echo ""
echo -e "  ${C_GREEN}✓ Selesai.${C_RESET} ${C_WHITE}$INSTALLED_COUNT skill aktif.${C_RESET}"
echo -e "  ${C_GREEN}● AGENTS.md:${C_RESET} ${C_DIM}Terkunci sebagai soul prompt di setiap request AI.${C_RESET}"
echo -e "  ${C_DIM}Ketik ${C_CYAN}opencode${C_DIM} lalu tekan ${C_WHITE}Ctrl + K${C_DIM} untuk memanggil skill.${C_RESET}\n"
